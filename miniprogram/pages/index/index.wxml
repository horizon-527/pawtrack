<view class="page"><view class="title">PawTrack · 宠物定位</view><view class="row"><text>模拟数据演示</text><switch checked="{{demo}}" bindchange="toggleDemo" /></view><view class="notice">{{status}}</view><map latitude="{{latitude}}" longitude="{{longitude}}" scale="16" markers="{{markers}}" polyline="{{polyline}}" style="width:100%;height:58vh"/><view class="card"><view>电量：{{battery}}%</view><view>位置采集：{{updated}}</view><view>最近 24 小时：{{count}} 个轨迹点</view></view><button bindtap="refresh">刷新位置</button></view>
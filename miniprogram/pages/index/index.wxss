.page{padding:32rpx;background:#f6f8f5;min-height:100vh;color:#24372b}.title{font-size:52rpx;font-weight:bold}.subtitle{font-size:26rpx;color:#63796a;margin:8rpx 0 30rpx}.row{display:flex;align-items:center;justify-content:space-between}.notice{padding:22rpx 0;color:#526b56;font-size:26rpx;line-height:1.6}.card{background:white;padding:26rpx;border-radius:22rpx;margin:24rpx 0;line-height:1.9}map{border-radius:22rpx}button{background:#245a3c;color:white;margin-top:16rpx;font-size:28rpx}.secondary{background:#e9f0e9;color:#245a3c}.small{font-size:24rpx;color:#63796a;line-height:1.6;margin:12rpx 0}input{border-bottom:1rpx solid #d9e2d8;padding:18rpx 0;margin:12rpx 0}.date{color:#245a3c;margin-top:14rpx}.footer{display:flex;justify-content:space-around;font-size:24rpx;color:#63796a;padding:40rpx 0}
